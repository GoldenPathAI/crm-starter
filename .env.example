# Secrets only. Everything else (app name, timezone, currency, URLs, limits, feature
# flags) belongs in src/lib/config.ts or in the code.

# Postgres. The app owns the "crm" schema and creates it on first migrate.
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm

# better-auth session signing key. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Shared secret for the machine API (/api/internal/crm/[orgSlug]/*) and the pnpm crm CLI.
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=

# Default workspace slug for the CLI when --org is not passed.
CRM_ORG=default

# Transactional mail (invitations, password reset). Without it those flows log the link
# to the server console instead of sending it.
RESEND_API_KEY=

# Document file uploads to S3. Omit to run without file attachments; bucket and region
# are config, not secrets, and live in src/lib/config.ts under files.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
